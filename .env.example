NODE_ENV=development
API_PORT=3001
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000

# Postgres
POSTGRES_USER=bravo
POSTGRES_PASSWORD=bravo
POSTGRES_DB=bravo_credit
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bravo:bravo@localhost:5432/bravo_credit?schema=public

# Redis: caché y colas
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Genera cada uno con: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# AES-256-GCM sobre el documento y el nombre. 32 bytes en hex.
PII_ENCRYPTION_KEY=
# Pepper del HMAC que indexa el documento sin descifrarlo.
DOCUMENT_HASH_PEPPER=

WEBHOOK_SIGNING_SECRET=
WEBHOOK_TOLERANCE_SECONDS=300

# Proveedores bancarios simulados
BANK_PROVIDER_BASE_URL=http://localhost:3002
BANK_PROVIDER_TIMEOUT_MS=5000
# Latencia y fallos inyectados para probar retry y circuit breaker.
BANK_PROVIDER_LATENCY_MS=150
BANK_PROVIDER_FAILURE_RATE=0.1

# Workers
WORKER_CONCURRENCY=4
OUTBOX_BATCH_SIZE=100
# Respaldo por si se pierde una notificación del LISTEN.
OUTBOX_POLL_INTERVAL_MS=5000

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
